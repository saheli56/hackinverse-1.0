{
  "name": "behaviorlock",
  "version": "1.0.0",
  "description": "A lockfile for what your software does. Pins runtime behavior and blocks unauthorized changes.",
  "type": "module",
  "main": "src/cli.js",
  "bin": {
    "behaviorlock": "./bin/behaviorlock.js"
  },
  "scripts": {
    "start": "node bin/behaviorlock.js",
    "init": "node bin/behaviorlock.js init",
    "check": "node bin/behaviorlock.js check",
    "ui": "node bin/behaviorlock.js ui",
    "dev:ui": "npm --prefix dashboard run dev",
    "dashboard": "node bin/behaviorlock.js ui",
    "build:ui": "npm --prefix dashboard run build",
    "demo": "node demo/run-demo.js",
    "test": "node test/suite.js",
    "test:safe": "node demo/test-scenario.js safe",
    "test:attack": "node demo/test-scenario.js attack",
    "test:telemetry": "node demo/test-scenario.js telemetry",
    "reset": "node demo/test-scenario.js reset",
    "inject:safe": "node demo/test-scenario.js inject safe",
    "inject:attack": "node demo/test-scenario.js inject attack",
    "inject:telemetry": "node demo/test-scenario.js inject telemetry"
  },
  "keywords": [
    "security",
    "lockfile",
    "behavior",
    "supply-chain",
    "sandbox",
    "canary",
    "devops"
  ],
  "author": "HackInverse Team",
  "license": "MIT"
}
